{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "openai",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "low"
      }
    ],
    "default_profile": "ask",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "dock": "right",
    "sidebar_side": "right",
  },
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "fast": "true",
        "reasoning": "high",
        "model": "gpt-5.6-sol",
        "mode": "agent",
      },
      "favorite_config_option_values": {
        "model": [
          "composer-2.5[fast=true]",
          "gpt-5.6-sol",
          "composer-2.5"
        ],
      },
      "type": "registry",
    },
  },
  "auto_install_extensions": {
    "biome": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "git-firefly": true,
    "helm": true,
    "html": true,
    "just": true,
    "log": true,
    "material-icon-theme": true,
    "one-dark-pro": true,
    "rainbow-csv": true,
    "ruby": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "JetBrains Mono NL",
  "buffer_font_size": 13,
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Material Icon Theme",
  "languages": {
    "YAML": {
      "format_on_save": "off",
      // "formatter": "language_server",
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "preferred_line_length": 120,
  "project_panel": {
    "dock": "left",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "soft_wrap": "bounded",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "cursor_shape": "underline",
  },
  "theme": {
    "dark": "One Dark Pro",
    "light": "One Light",
  },
  "ui_font_family": "JetBrains Mono NL",
  "ui_font_size": 14,
}
